# Copier en .env pour surcharger les valeurs par défaut au build (séparateur : virgule ou espace).
# Relais Nostr par défaut
VITE_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://nostr.mom,wss://relay.nostr.net,wss://offchain.pub
# Serveurs Blossom par ordre de préférence (le premier qui accepte devient le primaire)
VITE_BLOSSOM_SERVERS=https://blossom.nostr.build,https://blossom.primal.net,https://nostr.download,https://blosstr.com,https://cdn.nostrcheck.me
# Collectifs de modération de confiance (npub ou hex)
VITE_MODERATORS=
# Murs mis en avant sur la page d'accueil
VITE_FEATURED_TAGS=
# Nombre de signalements (clés distinctes) avant floutage
VITE_REPORT_THRESHOLD=3
