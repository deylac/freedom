# Copier en .env pour surcharger les valeurs par défaut au build (séparateur : virgule ou espace).
# Relais Nostr par défaut
VITE_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://nostr.mom,wss://relay.nostr.net,wss://offchain.pub
# Serveurs Blossom par ordre de préférence (le premier qui accepte devient le primaire)
VITE_BLOSSOM_SERVERS=https://nostr.download,https://cdn.nostrcheck.me,https://blossom.nostr.build,https://blossom.band,https://blossom.primal.net
# Collectifs de modération de confiance (npub ou hex)
VITE_MODERATORS=
# Murs mis en avant sur la page d'accueil
VITE_FEATURED_TAGS=
# Nombre de signalements (clés distinctes) avant floutage
VITE_REPORT_THRESHOLD=3
# Adresses de secours intégrées (miroirs du site), et clé du projet qui signe la liste publiée sur Nostr
VITE_MIRRORS=https://deylac.github.io/freedom/
VITE_PROJECT_NPUB=
# Nom incrusté en filigrane dans chaque vidéo filmée
VITE_WATERMARK_NAME=HashWall
# Adresse publique absolue (aperçus de liens sur les réseaux sociaux)
VITE_SITE_URL=https://deylac.github.io/freedom/
