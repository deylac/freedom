{
  "name": "hashwall",
  "private": true,
  "version": "0.1.0",
  "description": "HashWall — mur vidéo citoyen de 60 s, 100 % client, indexé sur Nostr (NIP-71) et stocké sur Blossom.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build:e2e && node e2e/run.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "blossom-client-sdk": "^5.1.0",
    "nostr-tools": "^2.25.4",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  }
}
